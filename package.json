{
  "name": "ucui",
  "version": "0.1.0",
  "description": "一套代码，双端渲染的 Vue 3 组件库：element-plus / ant-design-vue 统一 API，运行时可切换",
  "keywords": [
    "vue",
    "vue3",
    "components",
    "component-library",
    "ui",
    "element-plus",
    "ant-design-vue"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kimihiro233/ucui.git"
  },
  "type": "module",
  "types": "./types/index.d.ts",
  "main": "./dist/core.cjs",
  "module": "./dist/core.js",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./dist/core.js",
      "require": "./dist/core.cjs"
    },
    "./element": {
      "types": "./types/element.d.ts",
      "import": "./dist/element.js",
      "require": "./dist/element.cjs"
    },
    "./antd": {
      "types": "./types/antd.d.ts",
      "import": "./dist/antd.js",
      "require": "./dist/antd.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "types",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "dev": "vite",
    "build": "vite build --config vite.lib.config.js",
    "build:playground": "vite build",
    "preview": "vite preview",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "peerDependencies": {
    "ant-design-vue": "^4.2.0",
    "element-plus": "^2.4.0",
    "vue": "^3.3.0"
  },
  "peerDependenciesMeta": {
    "ant-design-vue": {
      "optional": true
    },
    "element-plus": {
      "optional": true
    }
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "@vitest/coverage-v8": "^5.0.1",
    "@vue/test-utils": "^2.5.1",
    "ant-design-vue": "^4.2.6",
    "element-plus": "^2.14.6",
    "happy-dom": "^20.14.5",
    "vite": "^6.0.11",
    "vite-plugin-vue-devtools": "^7.7.1",
    "vitepress": "^1.6.3",
    "vitest": "^5.0.1",
    "vue": "^3.5.13"
  }
}
